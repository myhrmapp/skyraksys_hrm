# ==============================================================================
# SkyrakSys HRM -- Deployment Configuration
#
# EDIT THIS FILE to retarget all deployment scripts to a different server.
# All PowerShell (.ps1) and Bash (.sh) scripts in this folder read from here.
#
# DO NOT commit real passwords here. Passwords are handled separately via
# the SKYRAKSYS_SSH_PASSWORD environment variable.
# ==============================================================================

# -- Server --------------------------------------------------------------------
SERVER_IP=46.225.73.94
SERVER_USER=deploy            # OS user on the server (e.g. ubuntu, deploy, your-name)
SERVER_DOMAIN=skyait.skyraksys.com

# -- GitHub Repository ---------------------------------------------------------
GIT_REPO=https://github.com/myhrmapp/skyraksys_hrm.git
GIT_BRANCH=skyraksys_hrm

# -- Application ---------------------------------------------------------------
APP_NAME=skyraksys_hrm
# APP_DIR is derived automatically in scripts as /home/$SERVER_USER/$APP_NAME
# Override here only if your server uses a non-standard home directory:
# APP_DIR=/opt/skyraksys_hrm
